---
import Base from '../../../layouts/Base.astro';import ProjectRow from '../../../components/ProjectRow.astro';import {siteData,langs,labels,type Lang} from '../../../lib/content';
export function getStaticPaths(){return langs.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Lang;const t=labels[lang];const {projects,settings}=await siteData();
---
<Base lang={lang} title={t.all}><main class="page" id="content"><p class="eyebrow">{lang==='en'?'Selected work & systems':'منتجات وأنظمة'}</p><h1>{t.all}</h1><p class="page-lead">{lang==='en'?'Products shipped, workflows connected, and the engineering behind them.':'منتجات طُوّرت، ومسارات عمل ترابطت، والهندسة وراءها.'}</p><div class="filters" role="group" aria-label={t.filter}><button data-filter="all" aria-pressed="true">{t.allFilter}</button>{settings.categories.map(c=><button data-filter={c.id} aria-pressed="false">{c.label[lang]}</button>)}</div><p id="filter-count" role="status" aria-live="polite" data-suffix={lang==='en'?'projects':'مشاريع'}>{projects.length} {lang==='en'?'projects':'مشاريع'}</p><div class="archive">{projects.map(project=><ProjectRow project={project} lang={lang}/>)}</div></main></Base>
<script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const rows=document.querySelectorAll<HTMLElement>('[data-category]');buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));let count=0;rows.forEach(row=>{row.hidden=button.dataset.filter!=='all'&&row.dataset.category!==button.dataset.filter;if(!row.hidden)count++;});const status=document.getElementById('filter-count');if(status)status.textContent=`${count} ${status.dataset.suffix}`;}));</script>
