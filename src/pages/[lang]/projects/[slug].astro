---
import {imageInfo} from '../../../lib/media';
import {tools} from '../../../tools/registry';
import Base from '../../../layouts/Base.astro';import {siteData,langs,labels,engagementLabels,type Lang} from '../../../lib/content';
export async function getStaticPaths(){const {projects}=await siteData();return langs.flatMap(lang=>projects.map(project=>({params:{lang,slug:project.data.slug},props:{project}})));}
const lang=Astro.params.lang as Lang;const {project}=Astro.props;const p=project.data;const t=labels[lang];const {projects,profile}=await siteData();const relatedTools=tools.filter(tool=>tool.relatedProject===p.slug);const next=projects[(projects.findIndex(x=>x.data.slug===p.slug)+1)%projects.length];
---
<Base lang={lang} title={p.seoTitle[lang]||p.title[lang]} description={p.seoDescription[lang]||p.summary[lang]} image={p.cover}><main class="page" id="content"><a class="text-link" href={`/${lang}/projects/`}>{t.back}</a><h1>{p.title[lang]}</h1><p class="page-lead">{p.summary[lang]}</p><dl class="case-meta"><div><dt>{lang==='en'?'Engagement':'نوع العمل'}</dt><dd>{engagementLabels[lang][p.engagement]}</dd></div><div><dt>{lang==='en'?'My role':'دوري'}</dt><dd>{p.role[lang]}</dd></div>{p.company&&<div><dt>{lang==='en'?'Company':'الشركة'}</dt><dd>{p.company}</dd></div>}{p.timeframe[lang]&&<div><dt>{lang==='en'?'Timeframe':'الفترة'}</dt><dd>{p.timeframe[lang]}</dd></div>}</dl><img class="case-poster" src={p.cover} alt={p.coverAlt[lang]} width={imageInfo(p.cover).width} height={imageInfo(p.cover).height} srcset={imageInfo(p.cover).srcset||undefined} sizes="(max-width:1100px) 90vw, 1000px" fetchpriority="high"/><div class="case-links">{p.liveUrl&&<a class="text-link" href={p.liveUrl}>{t.live}</a>}{p.repoUrl&&<a class="text-link" href={p.repoUrl}>{t.repo}</a>}{p.pdf&&<a class="text-link" href={p.pdf}>{t.pdf}</a>}</div>{p.gallery.length>0&&<section aria-labelledby="gallery-title"><h2 class="section-title" id="gallery-title">{t.gallery}</h2>{[...p.gallery].sort((a,b)=>a.order-b.order).map(m=><figure class="media-item">{m.type==='video'?<video controls playsinline preload="none" poster={m.poster} width={m.width} height={m.height} aria-label={m.alt[lang]}><source src={m.src} type="video/mp4"/><a href={m.src}>{lang==='en'?'Download video':'تحميل الفيديو'}</a></video>:<button class="image-open" data-enlarge={m.src} data-alt={m.alt[lang]} data-caption={m.caption[lang]} aria-label={`${t.enlarge}: ${m.alt[lang]}`}><img src={m.src} alt={m.alt[lang]} width={m.width} height={m.height} srcset={imageInfo(m.src).srcset||undefined} sizes="(max-width:1100px) 90vw, 1000px" loading="lazy" decoding="async"/></button>}<figcaption>{m.caption[lang]}{m.type==='image'&&<span class="image-hint"> · {t.enlarge}</span>}</figcaption></figure>)}{p.gallery.some(m=>m.type==='video')&&<details><summary>{t.demo}</summary><p class="prose">{p.solution[lang]} {p.implementation[lang]}</p><p>{lang==='en'?'Public videos are silent privacy-edited copies. This text explains the demonstrated workflow.':'الفيديوهات العامة نسخ صامتة منقّحة للخصوصية. يشرح هذا النص مسار العمل المعروض.'}</p></details>}</section>}<div class="case-content">{(['problem','solution','contribution','implementation','outcomes'] as const).map(key=><section><h2>{t[key]}</h2><p class="prose">{p[key][lang]}</p></section>)}<ul class="tags">{p.tags.map(tag=><li>{tag}</li>)}</ul>{relatedTools.length>0&&<section class="mt-14"><h2>{lang==='en'?'Try the related tools':'جرّب الأدوات ذات الصلة'}</h2><p>{lang==='en'?'Apply the measurement and planning methods behind this work.':'طبّق أساليب القياس والتخطيط المرتبطة بهذا العمل.'}</p><ul>{relatedTools.map(tool=><li><a class="text-link" href={`/${lang}/tools/${tool.slug}/`}>{tool.title[lang]}</a></li>)}</ul></section>}<section class="mt-14"><h2>{profile.contact[lang]}</h2><p>{profile.contactBody[lang]}</p><a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a></section></div><nav class="next-nav" aria-label={lang==='en'?'Project navigation':'التنقّل بين المشاريع'}><a href={`/${lang}/projects/`}>{t.all}</a>{next&&<a href={`/${lang}/projects/${next.data.slug}/`}>{t.next}: {next.data.title[lang]}</a>}</nav></main></Base>
