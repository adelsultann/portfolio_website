---
import '../styles/global.css';
import {siteData,labels,type Lang} from '../lib/content';
interface Props{lang:Lang;title?:string;description?:string;image?:string;noindex?:boolean;}
const {lang,title,description,image,noindex=false}=Astro.props;
const {profile,settings}=await siteData();const t=labels[lang];
const canonical=new URL(Astro.url.pathname,settings.domain).href;
const alternate=Astro.url.pathname.replace(/^\/(en|ar)\//,lang==='en'?'/ar/':'/en/');
const pageTitle=title?`${title} | ${profile.name[lang]}`:`${profile.name[lang]} | ${lang==='ar'?'مطور منتجات رقمية':'Product Engineer'}`;
const og=new URL((image||settings.ogImage).replace(/\.svg$/,'.jpg'),settings.domain).href;
const isPreview=import.meta.env.CF_PAGES_BRANCH&&import.meta.env.CF_PAGES_BRANCH!=='main';
---
<!doctype html><html lang={lang} dir={lang==='ar'?'rtl':'ltr'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>{lang==='ar'&&<link rel="preload" href="/fonts/thmanyah-display-regular.otf" as="font" type="font/otf" crossorigin/>}<meta name="theme-color" content="#0c1728"/><title>{pageTitle}</title><meta name="description" content={description||settings.description[lang]}/>{!noindex&&<link rel="canonical" href={canonical}/>}{!noindex&&<link rel="alternate" hreflang={lang} href={canonical}/>}{!noindex&&<link rel="alternate" hreflang={lang==='en'?'ar':'en'} href={new URL(alternate,settings.domain).href}/>}{!noindex&&<link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace(/^\/ar\//,'/en/'),settings.domain).href}/>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description||settings.description[lang]}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={og}/><meta property="og:locale" content={lang==='ar'?'ar_SA':'en_US'}/><meta name="twitter:card" content="summary_large_image"/>{(noindex||isPreview)&&<meta name="robots" content="noindex,nofollow"/>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:profile.name.en,jobTitle:'Product Engineer',url:settings.domain,address:{'@type':'PostalAddress',addressLocality:'Riyadh',addressCountry:'SA'},sameAs:[profile.github,profile.linkedin,profile.x].filter(Boolean)}).replace(/</g,'\u003c')}/></head><body>{isPreview&&<aside class="preview-banner">Preview deployment · Changes are not live on the production website.</aside>}<a class="skip" href="#content">{t.skip}</a><div class="shell"><header class="topbar"><a class="wordmark" href={`/${lang}/`}>{profile.name[lang]}</a><button class="menu-toggle" hidden aria-controls="site-links" aria-expanded="false">{lang==='en'?'Menu':'القائمة'}</button><nav id="site-links" class="toplinks" aria-label={lang==='en'?'Main navigation':'التنقّل الرئيسي'}><a href={`/${lang}/projects/`}>{t.projects}</a><a href={`/${lang}/#experience`}>{t.experience}</a><a href={`/${lang}/#certifications`}>{t.certifications}</a><a href={`/${lang}/#contact`}>{t.contact}</a><a href={`/${lang}/tools/`} aria-current={Astro.url.pathname.includes('/tools/')?'page':undefined}>{lang==='en'?'Useful tools':'أدوات مفيدة'}</a>{profile.cv&&<a class="cv-top" href={profile.cv} download>{t.cv}</a>}</nav><a class="language" href={noindex?'/ar/':alternate} lang={lang==='en'?'ar':'en'} hreflang={lang==='en'?'ar':'en'}>{lang==='en'?'العربية':'English'}</a></header><slot/><footer class="footer"><span>© {new Date().getFullYear()} {profile.name[lang]}</span><div class="social">{profile.github && <a href={profile.github}>GitHub</a>}{profile.linkedin && <a href={profile.linkedin}>LinkedIn</a>}{profile.x && <a href={profile.x}>X</a>}</div></footer></div><dialog class="lightbox" aria-label={lang==='en'?'Enlarged project image':'صورة المشروع المكبّرة'}><form method="dialog"><button>{t.close}</button></form><img alt="" width="1280" height="720"/><p></p></dialog><script>
const dialog=document.querySelector<HTMLDialogElement>('.lightbox');let opener:HTMLElement|null=null;
document.querySelectorAll<HTMLButtonElement>('[data-enlarge]').forEach(btn=>btn.addEventListener('click',()=>{if(!dialog)return;opener=btn;const img=dialog.querySelector('img')!;img.src=btn.dataset.enlarge!;img.alt=btn.dataset.alt||'';dialog.querySelector('p')!.textContent=btn.dataset.caption||'';dialog.showModal();}));
dialog?.addEventListener('close',()=>opener?.focus());dialog?.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');
if(menu){
 menu.hidden=false;
 const closeMenu=()=>menu.setAttribute('aria-expanded','false');
 menu.addEventListener('click',()=>menu.setAttribute('aria-expanded',String(menu.getAttribute('aria-expanded')!=='true')));
 document.querySelector('#site-links')?.addEventListener('click',closeMenu);
 document.addEventListener('keydown',e=>{if(e.key==='Escape' && menu.getAttribute('aria-expanded')==='true'){closeMenu();menu.focus();}});
}
</script></body></html>
