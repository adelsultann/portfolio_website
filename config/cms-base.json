{
  "backend": {
    "name": "git-gateway"
  },
  "publish_mode": "editorial_workflow",
  "site_url": "https://adelalsultan.com",
  "display_url": "https://adelalsultan.com",
  "logo_url": "/favicon.svg",
  "media_folder": "public/media/uploads",
  "public_folder": "/media/uploads",
  "media_libraries": {
    "default": {
      "config": {
        "max_file_size": 20971520
      }
    }
  },
  "collections": [
    {
      "name": "profile",
      "label": "Profile & About",
      "files": [
        {
          "name": "main",
          "label": "Profile & About",
          "file": "src/content/profile/main.json",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "widget": "object",
              "collapsed": true,
              "summary": "{{fields.en}}",
              "hint": "",
              "fields": [
                {
                  "name": "en",
                  "label": "English",
                  "widget": "string",
                  "required": true
                },
                {
                  "name": "ar",
                  "label": "العربية / Arabic",
                  "widget": "string",
                  "required": true
                }
              ]
            },
            {
              "name": "headline",
              "label": "Professional headline",
              "widget": "object",
              "collapsed": true,
              "summary": "{{fields.en}}",
              "hint": "",
              "fields": [
                {
                  "name": "en",
                  "label": "English",
                  "widget": "text",
                  "required": true
                },
                {
                  "name": "ar",
                  "label": "العربية / Arabic",
                  "widget": "text",
                  "required": true
                }
              ]
            },
            {
              "name": "intro",
              "label": "Short introduction",
              "widget": "object",
              "collapsed": true,
              "summary": "{{fields.en}}",
              "hint": "",
              "fields": [
                {
                  "name": "en",
                  "label": "English",
                  "widget": "text",
                  "required": true
                },
                {
                  "name": "ar",
                  "label": "العربية / Arabic",
                  "widget": "text",
                  "required": true
                }
              ]
            },
            {
              "name": "about",
              "label": "About",
              "widget": "object",
              "collapsed": true,
              "summary": "{{fields.en}}",
              "hint": "",
              "fields": [
                {
                  "name": "en",
                  "label": "English",
                  "widget": "text",
                  "required": true
                },
                {
                  "name": "ar",
                  "label": "العربية / Arabic",
                  "widget": "text",
                  "required": true
                }
              ]
            },
            {
              "name": "location",
              "label": "Location",
              "widget": "object",
              "collapsed": true,
              "summary": "{{fields.en}}",
              "hint": "",
              "fields": [
                {
                  "name": "en",
                  "label": "English",
                  "widget": "string",
                  "required": true
                },
                {
                  "name": "ar",
                  "label": "العربية / Arabic",
                  "widget": "string",
                  "required": true
                }
              ]
            },
            {
              "name": "email",
              "label": "Contact email",
              "widget": "string",
              "pattern": [
                "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "Enter a valid email"
              ]
            },
            {
              "name": "github",
              "label": "GitHub URL",
              "widget": "string",
              "required": false,
              "hint": "Optional. Use a verified HTTPS URL. Leave blank if unavailable."
            },
            {
              "name": "linkedin",
              "label": "LinkedIn URL",
              "widget": "string",
              "required": false,
              "hint": "Optional. Use a verified HTTPS URL. Leave blank if unavailable."
            },
            {
              "name": "cv",
              "label": "Public CV",
              "widget": "file",
              "required": false,
              "hint": "Replace with your public PDF CV. Never upload the private master evidence resume."
            },
            {
              "name": "contact",
              "label": "Contact heading",
              "widget": "object",
              "collapsed": true,
              "summary": "{{fields.en}}",
              "hint": "",
              "fields": [
                {
                  "name": "en",
                  "label": "English",
                  "widget": "string",
                  "required": true
                },
                {
                  "name": "ar",
                  "label": "العربية / Arabic",
                  "widget": "string",
                  "required": true
                }
              ]
            },
            {
              "name": "contactBody",
              "label": "Contact introduction",
              "widget": "object",
              "collapsed": true,
              "summary": "{{fields.en}}",
              "hint": "",
              "fields": [
                {
                  "name": "en",
                  "label": "English",
                  "widget": "text",
                  "required": true
                },
                {
                  "name": "ar",
                  "label": "العربية / Arabic",
                  "widget": "text",
                  "required": true
                }
              ]
            },
            {
              "name": "skills",
              "label": "Skill groups",
              "widget": "list",
              "collapsed": true,
              "summary": "{{fields.title.en}}",
              "fields": [
                {
                  "name": "title",
                  "label": "Group name",
                  "widget": "object",
                  "collapsed": true,
                  "summary": "{{fields.en}}",
                  "hint": "",
                  "fields": [
                    {
                      "name": "en",
                      "label": "English",
                      "widget": "string",
                      "required": true
                    },
                    {
                      "name": "ar",
                      "label": "العربية / Arabic",
                      "widget": "string",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "items",
                  "label": "Skills",
                  "widget": "list"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "experience",
      "label": "Experience",
      "folder": "src/content/experience",
      "format": "json",
      "extension": "json",
      "create": true,
      "delete": true,
      "identifier_field": "slug",
      "slug": "{{slug}}",
      "summary": "{{role.en}} · {{company}}",
      "sortable_fields": [
        "order"
      ],
      "fields": [
        {
          "name": "slug",
          "label": "Entry identifier",
          "widget": "string",
          "pattern": [
            "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "Use lowercase letters, numbers and hyphens"
          ]
        },
        {
          "name": "role",
          "label": "Role / title",
          "widget": "object",
          "collapsed": true,
          "summary": "{{fields.en}}",
          "hint": "",
          "fields": [
            {
              "name": "en",
              "label": "English",
              "widget": "string",
              "required": true
            },
            {
              "name": "ar",
              "label": "العربية / Arabic",
              "widget": "string",
              "required": true
            }
          ]
        },
        {
          "name": "company",
          "label": "Company",
          "widget": "string"
        },
        {
          "name": "type",
          "label": "Employment type",
          "widget": "select",
          "options": [
            "employment",
            "freelance",
            "contract",
            "founder"
          ]
        },
        {
          "name": "location",
          "label": "Location",
          "widget": "object",
          "collapsed": true,
          "summary": "{{fields.en}}",
          "hint": "",
          "fields": [
            {
              "name": "en",
              "label": "English",
              "widget": "string",
              "required": false
            },
            {
              "name": "ar",
              "label": "العربية / Arabic",
              "widget": "string",
              "required": false
            }
          ]
        },
        {
          "name": "start",
          "label": "Start date (YYYY-MM)",
          "widget": "string",
          "pattern": [
            "^\\d{4}-\\d{2}$",
            "Use YYYY-MM, e.g. 2025-03"
          ]
        },
        {
          "name": "end",
          "label": "End date (YYYY-MM)",
          "widget": "string",
          "required": false,
          "hint": "Leave blank for a current role."
        },
        {
          "name": "present",
          "label": "I currently work here",
          "widget": "boolean",
          "default": false
        },
        {
          "name": "summary",
          "label": "Role summary — bullet points",
          "widget": "object",
          "collapsed": true,
          "summary": "Add and reorder your role highlights",
          "hint": "Each item becomes one bullet on the homepage. No hyphens or special formatting needed.",
          "fields": [
            {
              "name": "en",
              "label": "English",
              "widget": "list",
              "required": true,
              "field": {
                "name": "point",
                "label": "Bullet point",
                "widget": "text"
              },
              "label_singular": "bullet point",
              "allow_reorder": true,
              "default": [],
              "min": 1
            },
            {
              "name": "ar",
              "label": "العربية / Arabic",
              "widget": "list",
              "required": true,
              "field": {
                "name": "point",
                "label": "Bullet point",
                "widget": "text"
              },
              "label_singular": "bullet point",
              "allow_reorder": true,
              "default": [],
              "min": 1
            }
          ]
        },
        {
          "name": "outcomes",
          "label": "Responsibilities and outcomes",
          "widget": "object",
          "fields": [
            {
              "name": "en",
              "label": "English bullet points",
              "widget": "list"
            },
            {
              "name": "ar",
              "label": "النقاط بالعربية / Arabic",
              "widget": "list"
            }
          ]
        },
        {
          "name": "tags",
          "label": "Technologies / skills",
          "widget": "list"
        },
        {
          "name": "companyUrl",
          "label": "Company URL",
          "widget": "string",
          "required": false,
          "hint": "Optional. Use a verified HTTPS URL. Leave blank if unavailable."
        },
        {
          "name": "relatedProjects",
          "label": "Related projects",
          "widget": "relation",
          "collection": "projects",
          "search_fields": [
            "title.en",
            "slug"
          ],
          "value_field": "slug",
          "display_fields": [
            "title.en"
          ],
          "multiple": true,
          "required": false,
          "default": []
        },
        {
          "name": "order",
          "label": "Display order",
          "widget": "number",
          "default": 100,
          "min": 0,
          "value_type": "int",
          "hint": "Lower numbers appear first. Use the number controls to move an entry up or down: 10, 20, 30…"
        },
        {
          "name": "status",
          "label": "Public visibility",
          "widget": "select",
          "options": [
            {
              "label": "Draft — hidden from public pages",
              "value": "draft"
            },
            {
              "label": "Published — included after deployment",
              "value": "published"
            }
          ],
          "default": "draft",
          "hint": "Set Published when ready. Then use Publish in the workflow. Your change is live only after Cloudflare finishes deploying."
        }
      ],
      "preview_path": "en/"
    },
